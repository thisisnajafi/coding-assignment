# Copy to backend/.env and fill in. Never commit the real .env file.
GAPGPT_API_KEY=your-gapgpt-api-key-here
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
AI_DEFAULT_MODEL=gpt-4o
AI_TIMEOUT_SECONDS=20
DATABASE_URL=sqlite:///./data/tickets.db
CORS_ORIGINS=http://localhost:3000
SEED_ON_STARTUP=true
# Demo auth (X-User header + demo user picker + /docs). Set false to disable header auth entirely.
DEMO_MODE=true
DEBUG=false
# AI cost/abuse limits (per user and per IP, per minute) and a global daily cap
AI_RATE_PER_MINUTE=5
AI_DAILY_CAP=300
